# EPGWeb — configuración Apache para la carpeta pública

# Sin listado de directorios
Options -Indexes

# No acceder a archivos ocultos y de configuración
<FilesMatch "^\.|\.(sqlite|db|log|md)$">
  Require all denied
</FilesMatch>

# Compresión (si el host lo permite)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml application/xml application/json
</IfModule>

# Caché de assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
